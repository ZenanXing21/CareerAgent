# OpenAI official example
CAREER_AGENT_LLM_API_KEY=replace-me
CAREER_AGENT_LLM_MODEL=gpt-5-mini
# Leave empty for the official OpenAI endpoint.
CAREER_AGENT_LLM_BASE_URL=
CAREER_AGENT_LLM_TIMEOUT_SECONDS=60

# Optional: consumed by the separately downloaded Liepin CLI.
# Complete `liepin-cli setup` interactively instead of pasting the token here when possible.
LIEPIN_USER_TOKEN=

# Optional official hosted Liepin MCP (read-only search integration).
LIEPIN_MCP_URL=https://open-agent.liepin.com/mcp/user
LIEPIN_MCP_USER_TOKEN=

# DeepSeek example (replace the three values above):
# DeepSeek V4 Pro uses JSON Object mode on Chat Completions.
# CAREER_AGENT_LLM_MODEL=deepseek-v4-flash
# CAREER_AGENT_LLM_BASE_URL=https://api.deepseek.com

# Qwen/DashScope OpenAI-compatible example:
# CAREER_AGENT_LLM_MODEL=qwen-plus
# CAREER_AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
